# Waycast 环境变量示例。
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，真实凭据不会进入版本库。

# LLM 提供方：任意 OpenAI Chat Completions 兼容端点（见 docs/adr/0007）。
# 必填项：base URL 与 API key（也接受 OPENAI_BASE_URL / OPENAI_API_KEY 兼容名）。
WAYCAST_BASE_URL="https://your-provider.example.com/v1"
WAYCAST_API_KEY="sk-..."
# 可选：模型名，默认 gpt-4o-mini
WAYCAST_MODEL="gpt-4o-mini"

# 可选：服务参数
WAYCAST_QUEUE_SIZE="100"
WAYCAST_HOST="0.0.0.0"
WAYCAST_PORT="8000"
WAYCAST_THREAD_ID="waycast-global"

# 可选：用户系统提示词文件路径（默认 ./waycast.prompt.txt，纯文本，内容原样读入）
WAYCAST_AGENT_CONFIG="waycast.prompt.txt"

# 可选：调试日志
# 本服务日志级别（默认 INFO；DEBUG 输出输入帧、LLM 请求/响应、单元派发与 result 帧）
# WAYCAST_LOG_LEVEL="INFO"
# 第三方依赖日志级别（默认 WARNING：屏蔽 httpx/openai/websockets；uvicorn 访问日志同样只在放开后出现）
# WAYCAST_DEPS_LOG_LEVEL="WARNING"
