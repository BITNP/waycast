# Waycast 环境变量示例。
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，真实凭据不会进入版本库。

# LLM 提供方：任意 OpenAI Chat Completions 兼容端点（见 docs/adr/0007）。
# 必填项：base URL 与 API key（也接受 OPENAI_BASE_URL / OPENAI_API_KEY 兼容名）。
WAYCAST_BASE_URL="https://your-provider.example.com/v1"
WAYCAST_API_KEY="sk-..."
# 可选：模型名，默认 gpt-4o-mini
WAYCAST_MODEL="gpt-4o-mini"

# 可选：服务参数
WAYCAST_QUEUE_SIZE="100"
WAYCAST_HOST="0.0.0.0"
WAYCAST_PORT="8000"
WAYCAST_THREAD_ID="waycast-global"

# 可选：用户系统提示词文件路径（默认 ./waycast.prompt.txt，纯文本，内容原样读入）
WAYCAST_AGENT_CONFIG="waycast.prompt.txt"

# 可选：LLM 请求超时与重试（openai SDK 默认 600s×(1+2 retries)，provider 挂死时
# 会静默阻塞整轮调用近半小时；收紧后超时快速失败，进 "agent invocation failed"
# 错误日志，worker 继续处理下一条输入）
# WAYCAST_LLM_TIMEOUT="120"
# WAYCAST_LLM_MAX_RETRIES="1"

# 可选：逐请求透传给 LLM 端的额外 JSON 字段（ChatOpenAI 官方一等字段
# extra_body；官方明确它是传 provider 专属参数的推荐方式，勿用 model_kwargs，
# 见 reference.langchain.com/python/langchain-openai/chat_models/base/ChatOpenAI，
# 查阅 2026-11-11）。默认不发。
# maas.bit.edu.cn 的 deepseek-v4-flash 默认开启思考（每次响应都有
# reasoning_tokens），置 reasoning_effort=none 可关闭（2026-11-10 实测
# reasoning_tokens 归零；2026-11-11 实测原生 ChatOpenAI(reasoning_effort=...)
# 标准参数效果相同，none 为该端点方言值、非 OpenAI 标准档位，故统一走透传）。
# WAYCAST_LLM_EXTRA_BODY='{"reasoning_effort": "none"}'

# 可选：调试日志
# 本服务日志级别（默认 INFO；DEBUG 输出输入帧、LLM 请求/响应、单元派发与 result 帧）
# WAYCAST_LOG_LEVEL="INFO"
# 第三方依赖日志级别（默认 WARNING：屏蔽 httpx/openai/websockets；uvicorn 访问日志同样只在放开后出现）
# WAYCAST_DEPS_LOG_LEVEL="WARNING"
# LLM 请求消息的记录方式（默认 incremental）：LLM API 无状态，每次调用都会重发
# 全部会话历史；incremental 只打印相对上次请求新增的消息（历史不再逐请求重复
# 打印，避免同一条旧输入被误读为多次输入），full 每次全量打印。历史前缀变化时
# （如摘要压缩重写）自动回退为全量打印。
# WAYCAST_LLM_LOG_MESSAGES="incremental"
